# Copy this file to .env and fill at least one source identifier.
# Uncomment and configure the sources you want to run.

# Greenhouse: board token from the company's Greenhouse job board.
# GREENHOUSE_BOARD_TOKEN=
# GREENHOUSE_COMPANY_NAME=

# Lever: site slug from jobs.lever.co/<site-slug>.
# LEVER_SITE=
# LEVER_COMPANY_NAME=
# LEVER_REGION=global

# SmartRecruiters: identifier from jobs.smartrecruiters.com/<company-identifier>.
SMARTRECRUITERS_COMPANY_IDENTIFIER=Equinox
SMARTRECRUITERS_COMPANY_NAME=Equinox
# Optional cap useful for quick checks; omit to fetch every published posting.
SMARTRECRUITERS_MAX_POSTINGS=3

# PostgreSQL connection string; set the real value only in .env.
DATABASE_URL=

# Jooble Poland: obtain key at https://pl.jooble.org/api/about; keep only in .env.
# JOOBLE_API_KEY=
